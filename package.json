{
  "name": "@angler/auth",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript SDK for angler-auth: a browser client, server helpers (JWT verification, session token, admin API) and Next.js helpers.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Angler-Network/angler-auth.git",
    "directory": "sdk"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
